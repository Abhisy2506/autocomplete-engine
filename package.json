{
  "name": "autocomplete-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run start:server\" \"npm run start:client\"",
    "dev:server": "npm --prefix apps/server run dev",
    "start:server": "npm --prefix apps/server run start",
    "dev:client": "npm --prefix apps/client run dev",
    "start:client": "npm --prefix apps/client run preview",
    "build:client": "npm --prefix apps/client run build",
    "build:engine": "npm --prefix packages/native-engine run build",
    "test": "node --test packages/native-engine/test.js",
    "benchmark": "node apps/server/benchmark.js",
    "seed": "node packages/database/src/seed.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
